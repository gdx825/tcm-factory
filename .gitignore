# ---------- 构建产物 ----------
build/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.iml

# ---------- 本地配置 ----------
# 含本机 SDK 路径，因机器而异
local.properties
.idea/
.DS_Store

# ---------- 签名密钥（绝对不能提交） ----------
# 密钥库与口令一旦泄露，他人即可签出与你完全相同的签名，
# 伪造「官方更新」去覆盖安装你已经发布给用户的版本。
*.jks
*.keystore
keystore.properties

# ---------- 支持者码私钥（绝对不能提交） ----------
# 私钥泄露意味着任何人都能自行签发支持者码。支持者码虽不解锁功能，
# 但那是「官方回礼」的凭据，被随意冒签就失去了意义。
# 另外签发记录含打赏者备注，属于他人隐私，同样不上传。
*.pem
激活码私钥.pem
签发记录.csv
licenses-out.csv

# ---------- Python 脚本运行痕迹 ----------
# 跑过 tools/ 下的脚本后会产生，属于本机缓存，不该进仓库。
__pycache__/
*.pyc

# ---------- 知识库打包产物 ----------
dist/
